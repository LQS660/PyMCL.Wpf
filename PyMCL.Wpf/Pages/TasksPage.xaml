<UserControl x:Class="PyMCL.Pages.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
        <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource PclSecondaryButton}" Click="Reload_Click"/>
        <StackPanel>
          <TextBlock Text="下载任务" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock Text="进行中与最近完成的任务" FontSize="12" Foreground="{StaticResource Brush.InkMuted}" Margin="0,4,0,0"/>
        </StackPanel>
      </DockPanel>
      <ListBox x:Name="List" BorderThickness="0" Background="Transparent">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border Background="#F7FAF8" BorderBrush="{StaticResource Brush.Line}"
                          BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <ContentPresenter/>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>
    </DockPanel>
  </Border>
</UserControl>
