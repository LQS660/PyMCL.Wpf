<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- PCL 风浅色：白底 + 绿点缀 #2E9B6B -->
  <Color x:Key="C.Accent">#2E9B6B</Color>
  <Color x:Key="C.AccentDeep">#1F7A52</Color>
  <Color x:Key="C.AccentLite">#4FBE8B</Color>
  <Color x:Key="C.Canvas">#F4F7F5</Color>
  <Color x:Key="C.Paper">#FFFFFF</Color>
  <Color x:Key="C.Shadow">#1A2B3A</Color>

  <SolidColorBrush x:Key="B.Accent" Color="#2E9B6B"/>
  <SolidColorBrush x:Key="B.AccentDeep" Color="#1F7A52"/>
  <SolidColorBrush x:Key="B.AccentLite" Color="#4FBE8B"/>
  <SolidColorBrush x:Key="B.AccentSoft" Color="#E7F5EE"/>
  <SolidColorBrush x:Key="B.AccentSoft2" Color="#D7EEE2"/>
  <SolidColorBrush x:Key="B.OnAccent" Color="#FFFFFF"/>

  <SolidColorBrush x:Key="B.Canvas" Color="#F4F7F5"/>
  <SolidColorBrush x:Key="B.Paper" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="B.Paper2" Color="#FAFCFB"/>
  <SolidColorBrush x:Key="B.Side" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="B.Chrome" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="B.Line" Color="#E5EAE7"/>
  <SolidColorBrush x:Key="B.LineSoft" Color="#EFF3F1"/>
  <SolidColorBrush x:Key="B.Hover" Color="#F1F5F3"/>
  <SolidColorBrush x:Key="B.Pressed" Color="#E6EDEA"/>

  <SolidColorBrush x:Key="B.Ink" Color="#1B2A26"/>
  <SolidColorBrush x:Key="B.InkSoft" Color="#4A5C56"/>
  <SolidColorBrush x:Key="B.InkMuted" Color="#7D8E88"/>
  <SolidColorBrush x:Key="B.InkFaint" Color="#A9B6B1"/>

  <SolidColorBrush x:Key="B.Danger" Color="#D64545"/>
  <SolidColorBrush x:Key="B.DangerSoft" Color="#FCEBEA"/>
  <SolidColorBrush x:Key="B.Warn" Color="#D68A17"/>
  <SolidColorBrush x:Key="B.WarnSoft" Color="#FDF3E2"/>
  <SolidColorBrush x:Key="B.Info" Color="#2F72C4"/>
  <SolidColorBrush x:Key="B.InfoSoft" Color="#EAF2FC"/>
  <SolidColorBrush x:Key="B.Ok" Color="#2E9B6B"/>

  <SolidColorBrush x:Key="B.Scroll" Color="#C9D4CF"/>
  <SolidColorBrush x:Key="B.ScrollHover" Color="#A7B7B0"/>
  <SolidColorBrush x:Key="B.Mask" Color="#0F1A16" Opacity="0.32"/>
  <SolidColorBrush x:Key="B.Glass" Color="#FFFFFF" Opacity="0.72"/>

  <LinearGradientBrush x:Key="B.BannerFill" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#2E9B6B" Offset="0"/>
    <GradientStop Color="#31A97A" Offset="0.5"/>
    <GradientStop Color="#1F7A52" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="B.PageWash" StartPoint="0,0" EndPoint="0.9,1">
    <GradientStop Color="#F4F8F6" Offset="0"/>
    <GradientStop Color="#EFF6F2" Offset="0.55"/>
    <GradientStop Color="#F6F9F7" Offset="1"/>
  </LinearGradientBrush>
</ResourceDictionary>
