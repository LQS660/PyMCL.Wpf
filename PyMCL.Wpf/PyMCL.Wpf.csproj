<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>PyMCL</RootNamespace>
    <AssemblyName>PyMCL.Wpf</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>PyMCL 启动器</AssemblyTitle>
    <Product>PyMCL 启动器 (WPF)</Product>
    <Version>3.2.0</Version>
  </PropertyGroup>

  <!-- 体积优先：无符号、无卫星资源；net48 运行时系统自带，唯一外部依赖 System.Text.Json 随包分发。 -->
  <PropertyGroup>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <XamlDebuggingInformation>false</XamlDebuggingInformation>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Optimize>true</Optimize>
    <NuGetAudit>false</NuGetAudit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- net48 没有 OpenFolderDialog，仅用 WinForms 的 FolderBrowserDialog（直接 GAC 引用，避免 SDK 注入 WinForms 全局 using 与 WPF 类型名冲突） -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
