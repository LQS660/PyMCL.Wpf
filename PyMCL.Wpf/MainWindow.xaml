<Window x:Class="PyMCL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PyMCL"
        Width="1040" Height="680"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource Brush.Canvas}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Border Background="{StaticResource Brush.Canvas}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="32"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource Brush.Paper}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,10,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#11B57E" Offset="0"/>
                  <GradientStop Color="#33C993" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <TextBlock Text="PyMCL" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="  ·  " Foreground="{StaticResource Brush.InkMuted}" VerticalAlignment="Center"/>
            <TextBlock x:Name="PageTitle" Text="启动" FontSize="13" Foreground="{StaticResource Brush.InkMuted}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource GhostButton}" Content="─" Click="Minimize_Click"/>
            <Button Style="{StaticResource GhostButton}" Content="□" Click="Maximize_Click"/>
            <Button Style="{StaticResource CloseButton}" Content="✕" Click="Close_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Brush.Side}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="18,20,18,8">
              <TextBlock Text="PLAIN CRAFT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}"/>
              <TextBlock Text="启动器" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
              <TextBlock Text="轻量 · 本机 WPF" FontSize="11" Foreground="{StaticResource Brush.InkMuted}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14">
              <Button x:Name="NavTasks" Content="下载任务" Style="{StaticResource PclNavButton}" Click="Nav_Click" Tag="tasks"/>
              <Border Margin="18,10,18,0" Padding="10,8" CornerRadius="10" Background="#F0F7F3">
                <TextBlock x:Name="BridgeStatus" Text="桥接: …" FontSize="11" Foreground="{StaticResource Brush.AccentDeep}" TextWrapping="Wrap"/>
              </Border>
            </StackPanel>

            <StackPanel Margin="0,12,0,0">
              <TextBlock Text="主菜单" FontSize="10" Foreground="{StaticResource Brush.InkMuted}" Margin="24,0,0,6"/>
              <Button x:Name="NavLaunch" Content="▶  启动" Style="{StaticResource PclNavButton}" Click="Nav_Click" Tag="launch"/>
              <Button x:Name="NavInstance" Content="▣  实例" Style="{StaticResource PclNavButton}" Click="Nav_Click" Tag="instance"/>
              <Button x:Name="NavDownload" Content="↓  下载" Style="{StaticResource PclNavButton}" Click="Nav_Click" Tag="download"/>
              <Button x:Name="NavSettings" Content="⚙  设置" Style="{StaticResource PclNavButton}" Click="Nav_Click" Tag="settings"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Grid Grid.Column="1">
          <Rectangle Opacity="0.9">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F2F6F4" Offset="0"/>
                <GradientStop Color="#E8F6EF" Offset="0.55"/>
                <GradientStop Color="#F7FAF8" Offset="1"/>
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,28,18">
            <ContentControl x:Name="PageHost"/>
          </ScrollViewer>
        </Grid>
      </Grid>

      <Border Grid.Row="2" Background="{StaticResource Brush.Paper}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Padding="14,0">
        <Grid>
          <TextBlock x:Name="StatusText" Text="就绪" FontSize="11" Foreground="{StaticResource Brush.InkMuted}" VerticalAlignment="Center"/>
          <ProgressBar x:Name="TaskProgress" Height="3" Minimum="0" Maximum="100" Value="0"
                       Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
