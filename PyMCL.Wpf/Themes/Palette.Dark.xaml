<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 深色：同一套键位，运行时整字典热替换 -->
  <Color x:Key="C.Accent">#3FB07C</Color>
  <Color x:Key="C.AccentDeep">#2C8E63</Color>
  <Color x:Key="C.AccentLite">#5FCB98</Color>
  <Color x:Key="C.Canvas">#141A18</Color>
  <Color x:Key="C.Paper">#1B2320</Color>
  <Color x:Key="C.Shadow">#000000</Color>

  <SolidColorBrush x:Key="B.Accent" Color="#3FB07C"/>
  <SolidColorBrush x:Key="B.AccentDeep" Color="#2C8E63"/>
  <SolidColorBrush x:Key="B.AccentLite" Color="#5FCB98"/>
  <SolidColorBrush x:Key="B.AccentSoft" Color="#1B3A2C"/>
  <SolidColorBrush x:Key="B.AccentSoft2" Color="#204636"/>
  <SolidColorBrush x:Key="B.OnAccent" Color="#0E1613"/>

  <SolidColorBrush x:Key="B.Canvas" Color="#141A18"/>
  <SolidColorBrush x:Key="B.Paper" Color="#1B2320"/>
  <SolidColorBrush x:Key="B.Paper2" Color="#1F2825"/>
  <SolidColorBrush x:Key="B.Side" Color="#171E1B"/>
  <SolidColorBrush x:Key="B.Chrome" Color="#171E1B"/>
  <SolidColorBrush x:Key="B.Line" Color="#2C3733"/>
  <SolidColorBrush x:Key="B.LineSoft" Color="#242E2A"/>
  <SolidColorBrush x:Key="B.Hover" Color="#232D29"/>
  <SolidColorBrush x:Key="B.Pressed" Color="#2A3631"/>

  <SolidColorBrush x:Key="B.Ink" Color="#E7EFEB"/>
  <SolidColorBrush x:Key="B.InkSoft" Color="#B9C7C1"/>
  <SolidColorBrush x:Key="B.InkMuted" Color="#8B9A94"/>
  <SolidColorBrush x:Key="B.InkFaint" Color="#6A7873"/>

  <SolidColorBrush x:Key="B.Danger" Color="#E8615F"/>
  <SolidColorBrush x:Key="B.DangerSoft" Color="#3A2321"/>
  <SolidColorBrush x:Key="B.Warn" Color="#E5A73C"/>
  <SolidColorBrush x:Key="B.WarnSoft" Color="#3A2F1C"/>
  <SolidColorBrush x:Key="B.Info" Color="#5A9CE8"/>
  <SolidColorBrush x:Key="B.InfoSoft" Color="#1E2A3A"/>
  <SolidColorBrush x:Key="B.Ok" Color="#3FB07C"/>

  <SolidColorBrush x:Key="B.Scroll" Color="#39453F"/>
  <SolidColorBrush x:Key="B.ScrollHover" Color="#4E5D56"/>
  <SolidColorBrush x:Key="B.Mask" Color="#000000" Opacity="0.5"/>
  <SolidColorBrush x:Key="B.Glass" Color="#1B2320" Opacity="0.78"/>

  <LinearGradientBrush x:Key="B.BannerFill" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#1F6B4B" Offset="0"/>
    <GradientStop Color="#2A8A62" Offset="0.5"/>
    <GradientStop Color="#154B36" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="B.PageWash" StartPoint="0,0" EndPoint="0.9,1">
    <GradientStop Color="#151C19" Offset="0"/>
    <GradientStop Color="#18211D" Offset="0.55"/>
    <GradientStop Color="#141A18" Offset="1"/>
  </LinearGradientBrush>
</ResourceDictionary>
