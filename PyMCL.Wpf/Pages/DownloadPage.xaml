<UserControl x:Class="PyMCL.Pages.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}" MaxWidth="560" HorizontalAlignment="Left">
    <StackPanel>
      <TextBlock Text="下载游戏版本" FontSize="15" FontWeight="SemiBold"/>
      <TextBlock Text="填写版本号并选择加载器后开始" FontSize="12" Foreground="{StaticResource Brush.InkMuted}" Margin="0,4,0,16"/>

      <TextBlock Text="实例" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="InstanceBox" Margin="0,0,0,12"/>

      <TextBlock Text="版本 ID" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="VersionBox" Text="1.20.4" Margin="0,0,0,12"/>

      <TextBlock Text="加载器" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="LoaderBox" SelectedIndex="0" Margin="0,0,0,16">
        <ComboBoxItem Content="vanilla"/>
        <ComboBoxItem Content="fabric"/>
        <ComboBoxItem Content="forge"/>
        <ComboBoxItem Content="quilt"/>
        <ComboBoxItem Content="neoforge"/>
      </ComboBox>

      <Button Content="开始下载" Style="{StaticResource PclPrimaryButton}" HorizontalAlignment="Left" Click="Download_Click"/>
      <TextBlock x:Name="Hint" Margin="0,14,0,0" Foreground="{StaticResource Brush.InkMuted}" TextWrapping="Wrap"/>
    </StackPanel>
  </Border>
</UserControl>
