<Window x:Class="PyMCL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PyMCL"
        Width="1180" Height="740" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AllowDrop="True"
        Background="{DynamicResource B.Canvas}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Border x:Name="RootBorder" Background="{DynamicResource B.Canvas}"
          BorderBrush="{DynamicResource B.Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- 壁纸层：压在所有兄弟控件最下面，整窗归它画；鼠标穿透 -->
      <Grid x:Name="WallHost" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True"/>

      <!-- 标题栏 -->
      <Border x:Name="ChromeBar" Grid.Row="0" Background="{DynamicResource B.Chrome}" BorderBrush="{DynamicResource B.LineSoft}" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <Border Width="20" Height="20" CornerRadius="6">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#4FBE8B" Offset="0"/>
                  <GradientStop Color="#1F7A52" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <TextBlock Text="P" Foreground="White" FontSize="12" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="PyMCL" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0"/>
            <Border Width="1" Height="14" Background="{DynamicResource B.Line}" Margin="10,0"/>
            <TextBlock x:Name="PageTitle" FontSize="12.5" Foreground="{DynamicResource B.InkMuted}" VerticalAlignment="Center"/>
            <Border x:Name="BridgePill" CornerRadius="999" Padding="7,1,8,2" Margin="10,0,0,0"
                    Background="{DynamicResource B.AccentSoft}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="BridgeDot" Width="6" Height="6" Fill="{DynamicResource B.Warn}" VerticalAlignment="Center"/>
                <TextBlock x:Name="BridgeText" FontSize="11" Margin="5,0,0,0"
                           Foreground="{DynamicResource B.AccentDeep}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="ThemeBtn" Style="{StaticResource Btn.Caption}" FontSize="13" Content="&#xE708;"/>
            <Button x:Name="MinBtn" Style="{StaticResource Btn.Caption}" Content="&#xE921;"/>
            <Button x:Name="MaxBtn" Style="{StaticResource Btn.Caption}" Content="&#xE922;"/>
            <Button x:Name="CloseBtn" Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 主体 -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SideCol" Width="196"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SideBar" Grid.Column="0" Background="{DynamicResource B.Side}" BorderBrush="{DynamicResource B.LineSoft}" BorderThickness="0,0,1,0">
          <DockPanel>
            <Border x:Name="SideFooter" DockPanel.Dock="Bottom" Padding="0,6,0,10">
              <StackPanel x:Name="PinnedHost"/>
            </Border>
            <ScrollViewer x:Name="NavScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,0,4">
              <StackPanel x:Name="NavHost"/>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Thumb x:Name="SideGrip" Grid.Column="1" Width="4" Cursor="SizeWE" Background="Transparent">
          <Thumb.Template>
            <ControlTemplate TargetType="Thumb">
              <Border Background="Transparent">
                <Border x:Name="L" Width="2" Background="Transparent" HorizontalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="L" Property="Background" Value="{DynamicResource B.Accent}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Thumb.Template>
        </Thumb>

        <Grid Grid.Column="2">
          <Rectangle x:Name="PageWash" Fill="{DynamicResource B.PageWash}"/>
          <ContentControl x:Name="PageHost" Focusable="False"/>
          <Border x:Name="DockHost" VerticalAlignment="Bottom" Margin="16,0,16,14" Visibility="Collapsed"/>
        </Grid>
      </Grid>

      <!-- 浮层 -->
      <Canvas x:Name="FlyHost" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False"/>
      <!-- 拖文件进来时的提示罩：告诉用户松手会发生什么，对齐 Qt download_hub 的 drop veil -->
      <Border x:Name="DropVeil" Grid.Row="1" Visibility="Collapsed" IsHitTestVisible="False"
              Background="{DynamicResource B.Mask}" Margin="0">
        <Border CornerRadius="14" Padding="26,20,26,22" BorderThickness="2"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource B.Paper}" BorderBrush="{DynamicResource B.Accent}">
          <StackPanel>
            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                       HorizontalAlignment="Center" Foreground="{DynamicResource B.Accent}"/>
            <!-- 文案在 MainWindow 构造里用 L() 填：XAML 里写死中文就绕开了词表 -->
            <TextBlock x:Name="DropVeilTitle" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="DropVeilHint" FontSize="12" Margin="0,3,0,0" MaxWidth="360"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource B.InkMuted}"/>
          </StackPanel>
        </Border>
      </Border>

      <StackPanel x:Name="ToastHost" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0"/>
      <Grid x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"/>
    </Grid>
  </Border>
</Window>
