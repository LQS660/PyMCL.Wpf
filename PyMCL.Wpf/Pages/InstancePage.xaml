<UserControl x:Class="PyMCL.Pages.InstancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
        <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource PclSecondaryButton}" Click="Reload_Click"/>
        <StackPanel>
          <TextBlock Text="游戏实例" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock Text="每个实例对应独立游戏目录" FontSize="12" Foreground="{StaticResource Brush.InkMuted}" Margin="0,4,0,0"/>
        </StackPanel>
      </DockPanel>
      <ListBox x:Name="List" BorderThickness="0" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="bd" Background="#F7FAF8" BorderBrush="{StaticResource Brush.Line}"
                          BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                      <Setter TargetName="bd" Property="BorderBrush" Value="#B7E5D0"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                      <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>
    </DockPanel>
  </Border>
</UserControl>
