<UserControl x:Class="PyMCL.Pages.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Hero -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16" ClipToBounds="True">
      <Grid Height="168">
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#12B57E" Offset="0"/>
              <GradientStop Color="#0D9A6A" Offset="0.45"/>
              <GradientStop Color="#1CC992" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <!-- soft orbs -->
        <Ellipse Width="220" Height="220" Margin="-40,-80,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.18" Fill="White"/>
        <Ellipse Width="160" Height="160" Margin="0,-30,-50,0" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.12" Fill="White"/>
        <Grid Margin="28,22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="准备出发" FontSize="13" Foreground="#CCFFFFFF"/>
            <TextBlock Text="启动 Minecraft" FontSize="28" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"/>
            <TextBlock Text="选好版本与账号，一键进入世界" FontSize="13" Foreground="#E6FFFFFF" Margin="0,8,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" Content="启动游戏" Style="{StaticResource PclPrimaryButton}"
                  FontSize="16" Padding="36,14" VerticalAlignment="Center" Click="Launch_Click"
                  Background="White" Foreground="#0A8F62">
            <Button.Resources>
              <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="999"/>
              </Style>
            </Button.Resources>
          </Button>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="启动配置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

          <TextBlock Text="实例" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="InstanceBox" Margin="0,0,0,12"/>

          <TextBlock Text="版本" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="VersionBox" Margin="0,0,0,12"/>

          <TextBlock Text="账号" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="AccountBox" Margin="0,0,0,12"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="离线名" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="UserNameBox" Text="Player"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="内存 (MB)" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="MemoryBox" Text="4096"/>
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="启动游戏" Style="{StaticResource PclPrimaryButton}" Click="Launch_Click" Margin="0,0,10,0"/>
            <Button Content="刷新列表" Style="{StaticResource PclSecondaryButton}" Click="Reload_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="提示" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock x:Name="Hint" TextWrapping="Wrap" LineHeight="22"
                     Foreground="{StaticResource Brush.InkMuted}"
                     Text="界面已按 PCL 气质重绘：青绿主色、无边框标题栏、圆角导航与胶囊按钮。后端仍走本机 C 桥，不依赖浏览器。"/>
          <Border Margin="0,18,0,0" Padding="12" CornerRadius="10" Background="{StaticResource Brush.AccentSoft}">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Brush.AccentDeep}"
                       Text="若列表为空，先到「下载」安装版本，或确认桥接状态为已连接。"/>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
